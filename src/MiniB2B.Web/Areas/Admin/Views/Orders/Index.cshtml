@using MiniB2B.Entities.Dtos.Orders
@using MiniB2B.Web.Helpers
@model PagedResult<OrderListItemDto>
@{
    ViewData["Title"] = "Sipariş Yönetimi";
    var filter = (AdminOrderSearchRequest)ViewData["Filter"]!;
}

<h2 class="mb-3">Sipariş Yönetimi</h2>

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-md-6">
        <input type="text" name="SearchTerm" value="@filter.SearchTerm" class="form-control"
               placeholder="Sipariş no (#10001), müşteri adı veya e-posta..." />
    </div>
    <div class="col-md-4">
        <select name="Status" class="form-select">
            <option value="">Tüm durumlar</option>
            <option value="Pending" selected="@(filter.Status == OrderStatus.Pending)">Beklemede</option>
            <option value="Approved" selected="@(filter.Status == OrderStatus.Approved)">Onaylandı</option>
            <option value="Rejected" selected="@(filter.Status == OrderStatus.Rejected)">Reddedildi</option>
        </select>
    </div>
    <div class="col-md-2 d-grid">
        <button type="submit" class="btn btn-primary">Filtrele</button>
    </div>
</form>

@if (Model.TotalCount == 0)
{
    <div class="alert alert-info">Kriterlere uygun sipariş bulunamadı.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Sipariş No</th>
                    <th>Müşteri</th>
                    <th>Tarih</th>
                    <th class="text-center">Ürün Sayısı</th>
                    <th class="text-end">Toplam Tutar</th>
                    <th class="text-center">Durum</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold">#@order.OrderNumber</td>
                        <td>@order.CustomerName</td>
                        <td>@DisplayFormat.Date(order.OrderDate)</td>
                        <td class="text-center">@order.ItemCount</td>
                        <td class="text-end">@DisplayFormat.Money(order.TotalAmount)</td>
                        <td class="text-center"><partial name="_OrderStatusBadge" model="order.Status" /></td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">Detay</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav>
            <ul class="pagination pagination-sm">
                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-SearchTerm="@filter.SearchTerm"
                           asp-route-Status="@filter.Status"
                           asp-route-Page="@i">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
}