@using MiniB2B.Web.Areas.Admin.Models
@using MiniB2B.Web.Helpers

@model AdminProductFormViewModel
@{
    ViewData["Title"] = Model.IsEdit ? "Ürün Düzenle" : "Yeni Ürün";
}

<h2 class="mb-3">@ViewData["Title"]</h2>

<form asp-action="@(Model.IsEdit ? "Edit" : "Create")"
      asp-route-id="@(Model.IsEdit ? Model.Product.Id.ToString() : null)"
      method="post" enctype="multipart/form-data">

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="Product.ProductCode" class="form-label">Ürün Kodu *</label>
            <input asp-for="Product.ProductCode" class="form-control" />
            <span asp-validation-for="Product.ProductCode" class="text-danger small"></span>
        </div>
        <div class="col-md-8">
            <label asp-for="Product.Name" class="form-label">Ürün Adı *</label>
            <input asp-for="Product.Name" class="form-control" />
            <span asp-validation-for="Product.Name" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Product.Brand" class="form-label">Marka *</label>
            <input asp-for="Product.Brand" class="form-control" />
            <span asp-validation-for="Product.Brand" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Product.CategoryId" class="form-label">Kategori *</label>
            <select asp-for="Product.CategoryId" asp-items="Model.Categories" class="form-select">
                <option value="0">Kategori seçiniz</option>
            </select>
            <span asp-validation-for="Product.CategoryId" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Product.ManufacturerCode" class="form-label">Üretici Kodu</label>
            <input asp-for="Product.ManufacturerCode" class="form-control" />
            <span asp-validation-for="Product.ManufacturerCode" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Product.SpecialCode1" class="form-label">Özel Kod 1</label>
            <input asp-for="Product.SpecialCode1" class="form-control" />
            <span asp-validation-for="Product.SpecialCode1" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Product.SpecialCode2" class="form-label">Özel Kod 2</label>
            <input asp-for="Product.SpecialCode2" class="form-control" />
            <span asp-validation-for="Product.SpecialCode2" class="text-danger small"></span>
        </div>
        <div class="col-12">
            <label asp-for="Product.Description" class="form-label">Açıklama</label>
            <textarea asp-for="Product.Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Product.Description" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Product.Price" class="form-label">Fiyat (₺) *</label>
            <input asp-for="Product.Price" type="number" step="0.01" min="0.01" class="form-control" />
            <span asp-validation-for="Product.Price" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Product.StockQuantity" class="form-label">Stok Miktarı *</label>
            <input asp-for="Product.StockQuantity" type="number" min="0" class="form-control" />
            <span asp-validation-for="Product.StockQuantity" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Product.CriticalStockLevel" class="form-label">Kritik Stok Seviyesi *</label>
            <input asp-for="Product.CriticalStockLevel" type="number" min="0" class="form-control" />
            <span asp-validation-for="Product.CriticalStockLevel" class="text-danger small"></span>
        </div>

        <div class="col-md-8">
            <label asp-for="ImageFile" class="form-label">Ürün Resmi</label>
            <input asp-for="ImageFile" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" />
            <div class="form-text">JPG, PNG veya WEBP, en fazla 2 MB.@(Model.IsEdit ? " Boş bırakılırsa mevcut resim korunur." : "")</div>
            <span asp-validation-for="ImageFile" class="text-danger small"></span>

            @if (Model.CurrentImageUrl is not null)
            {
                <img src="@Model.CurrentImageUrl" alt="Mevcut resim" class="img-thumbnail mt-2" style="max-height: 120px;" />
            }
        </div>
        <div class="col-md-4 d-flex align-items-center">
            <div class="form-check mt-3">
                <input asp-for="Product.IsActive" class="form-check-input" />
                <label asp-for="Product.IsActive" class="form-check-label">Satışta (aktif)</label>
            </div>
        </div>
    </div>

    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Kaydet</button>
        <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}