@using MiniB2B.Web.Areas.Admin.Models
@model SliderFormViewModel
@{
    ViewData["Title"] = Model.IsEdit ? "Slider Düzenle" : "Yeni Slider";
}

<h2 class="mb-3">@ViewData["Title"]</h2>

<form asp-action="@(Model.IsEdit ? "Edit" : "Create")"
      asp-route-id="@(Model.IsEdit ? Model.Slider.Id.ToString() : null)"
      method="post" enctype="multipart/form-data">

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row g-3" style="max-width: 700px;">
        <div class="col-12">
            <label asp-for="Slider.Title" class="form-label">Başlık *</label>
            <input asp-for="Slider.Title" class="form-control" />
            <span asp-validation-for="Slider.Title" class="text-danger small"></span>
        </div>
        <div class="col-md-8">
            <label asp-for="Slider.LinkUrl" class="form-label">Bağlantı (opsiyonel)</label>
            <input asp-for="Slider.LinkUrl" class="form-control" placeholder="/Products veya https://..." />
            <div class="form-text">Sadece site içi (/ ile başlayan) veya https:// adresleri kabul edilir.</div>
            <span asp-validation-for="Slider.LinkUrl" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Slider.DisplayOrder" class="form-label">Sıra</label>
            <input asp-for="Slider.DisplayOrder" type="number" min="0" class="form-control" />
            <span asp-validation-for="Slider.DisplayOrder" class="text-danger small"></span>
        </div>
        <div class="col-md-8">
            <label asp-for="ImageFile" class="form-label">Görsel @(Model.IsEdit ? "" : "*")</label>
            <input asp-for="ImageFile" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" />
            <div class="form-text">JPG, PNG veya WEBP, en fazla 2 MB.@(Model.IsEdit ? " Boş bırakılırsa mevcut görsel korunur." : "")</div>
            <span asp-validation-for="ImageFile" class="text-danger small"></span>

            @if (Model.CurrentImageUrl is not null)
            {
                <img src="@Model.CurrentImageUrl" alt="" class="img-thumbnail mt-2" style="max-height: 120px;" />
            }
        </div>
        <div class="col-md-4 d-flex align-items-center">
            <div class="form-check mt-3">
                <input asp-for="Slider.IsActive" class="form-check-input" />
                <label asp-for="Slider.IsActive" class="form-check-label">Yayında</label>
            </div>
        </div>
    </div>

    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Kaydet</button>
        <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}