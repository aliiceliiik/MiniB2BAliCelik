@model IReadOnlyList<SliderFormDto>
@{
    ViewData["Title"] = "Slider Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Slider Yönetimi</h2>
    <a asp-action="Create" class="btn btn-success">+ Yeni Slider</a>
</div>

@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">Henüz slider eklenmemiş.</div>
}
else
{
    <table class="table align-middle">
        <thead class="table-light">
            <tr>
                <th style="width: 140px;">Görsel</th>
                <th>Başlık</th>
                <th>Bağlantı</th>
                <th class="text-center">Sıra</th>
                <th class="text-center">Durum</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var slider in Model)
            {
                <tr class="@(slider.IsActive ? "" : "table-secondary text-muted")">
                    <td><img src="@slider.ImageUrl" alt="" class="img-thumbnail" style="max-height: 60px;" /></td>
                    <td>@slider.Title</td>
                    <td class="small text-muted">@(slider.LinkUrl ?? "-")</td>
                    <td class="text-center">@slider.DisplayOrder</td>
                    <td class="text-center">@(slider.IsActive ? "Aktif" : "Pasif")</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@slider.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}