@using MiniB2B.Web.Helpers
@model UserEditDto
@{
    ViewData["Title"] = "Kullanıcı Düzenle";
    var isSelf = ViewData["IsSelf"] as bool? == true;
}

<h2 class="mb-3">@Model.FirstName @Model.LastName</h2>

<div class="card mb-4" style="max-width: 500px;">
    <div class="card-body py-2 small">
        <div>Kayıt tarihi: <strong>@DisplayFormat.Date(Model.CreatedAt)</strong></div>
        <div>Toplam sipariş: <strong>@Model.OrderCount</strong></div>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="FirstName" class="form-label">Ad</label>
            <input asp-for="FirstName" class="form-control" />
            <span asp-validation-for="FirstName" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="LastName" class="form-label">Soyad</label>
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Email" class="form-label">E-posta</label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Phone" class="form-label">Telefon</label>
            <input asp-for="Phone" class="form-control" />
            <span asp-validation-for="Phone" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="UserName" class="form-label">Kullanıcı Adı</label>
            <input asp-for="UserName" class="form-control" />
            <span asp-validation-for="UserName" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="NewPassword" class="form-label">Yeni Şifre</label>
            <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
            <div class="form-text">Boş bırakılırsa şifre değişmez.</div>
            <span asp-validation-for="NewPassword" class="text-danger small"></span>
        </div>
        @if (isSelf)
        {
            <input type="hidden" asp-for="Role" />
            <input type="hidden" asp-for="IsActive" />
            <div class="col-12">
                <div class="alert alert-secondary mb-0 small">
                    Kendi hesabınızı düzenliyorsunuz. Rolünüz ve hesap durumunuz buradan değiştirilemez.
                </div>
            </div>
        }
        else
        {
            <div class="col-md-6">
                <label asp-for="Role" class="form-label">Rol</label>
                <select asp-for="Role" class="form-select">
                    <option value="Customer">Müşteri</option>
                    <option value="Admin">Yönetici</option>
                </select>
            </div>
            <div class="col-md-6 d-flex align-items-end">
                <div class="form-check mb-2">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label">Hesap aktif</label>
                </div>
            </div>
        }
    </div>

    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Kaydet</button>
        <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}