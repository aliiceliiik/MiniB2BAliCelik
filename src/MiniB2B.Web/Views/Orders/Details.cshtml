@model OrderDetailDto
@{
    ViewData["Title"] = $"Sipariş #{Model.OrderNumber}";
    var justCreated = ViewData["JustCreated"] as bool? == true;
}

@if (justCreated)
{
    <div class="alert alert-success">
        Siparişiniz başarıyla oluşturuldu. Sipariş numaranız: <strong>#@Model.OrderNumber</strong>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-2">
    <h2 class="mb-0">Sipariş #@Model.OrderNumber</h2>
    <partial name="_OrderStatusBadge" model="Model.Status" />
</div>
<p class="text-muted">Sipariş tarihi: @DisplayFormat.Date(Model.OrderDate)</p>

<partial name="_OrderItemsTable" model="Model" />

<a asp-action="Index" class="btn btn-outline-secondary">Siparişlerime dön</a>