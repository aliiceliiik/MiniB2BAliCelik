@model MiniB2B.Entities.Dtos.Common.PagedResult<OrderListItemDto>
@{
    ViewData["Title"] = "Siparişlerim";
}

<h2 class="mb-3">Siparişlerim</h2>

@if (Model.TotalCount == 0)
{
    <div class="alert alert-info">
        Henüz siparişiniz bulunmuyor. <a asp-controller="Products" asp-action="Index">Ürünlere göz atın</a>.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Sipariş No</th>
                    <th>Tarih</th>
                    <th class="text-center">Ürün Sayısı</th>
                    <th class="text-end">Toplam Tutar</th>
                    <th class="text-center">Durum</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold">#@order.OrderNumber</td>
                        <td>@DisplayFormat.Date(order.OrderDate)</td>
                        <td class="text-center">@order.ItemCount</td>
                        <td class="text-end">@DisplayFormat.Money(order.TotalAmount)</td>
                        <td class="text-center"><partial name="_OrderStatusBadge" model="order.Status" /></td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">Detay</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav>
            <ul class="pagination pagination-sm">
                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
}